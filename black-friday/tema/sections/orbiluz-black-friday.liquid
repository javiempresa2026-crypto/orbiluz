{%- comment -%}
  Black Friday de Orbiluz: cabecera negra con la oferta, cuenta atrás y los 4 productos con su precio rebajado.
  Autocontenida (estilos con prefijo .bf-). Los descuentos son automáticos en Shopify: se aplican solos en el carrito.
  El precio tachado es el precio habitual de la tienda (el mismo de los 30 días anteriores), no uno inflado.
{%- endcomment -%}
{%- liquid
  assign pct = section.settings.descuento_uno
  assign pct2 = section.settings.descuento_dos
  assign factor = 100 | minus: pct
  assign productos = 'lampara-bola-cristal-3d,proyector-ondas-de-agua,reloj-led-3d,globo-terraqueo-que-levita' | split: ','
-%}

<section id="bf" class="bf" aria-label="Black Friday">
  <div class="bf__estrellas" aria-hidden="true"></div>
  <div class="bf__inner page-width">
    <p class="bf__eyebrow">Black Friday · {{ section.settings.fechas }}</p>
    <h2 class="bf__titulo">Apaga la luz.<br><span class="bf__marca">Enciende el Black Friday.</span></h2>

    <div class="bf__ofertas">
      <div class="bf__oferta">
        <span class="bf__pct">−{{ pct }} %</span>
        <span class="bf__txt">en todo</span>
      </div>
      <div class="bf__oferta bf__oferta--top">
        <span class="bf__pct">−{{ pct2 }} %</span>
        <span class="bf__txt">llevando 2 o más</span>
      </div>
    </div>
    <p class="bf__nota">Sin códigos: el descuento se aplica solo en el carrito. Envío gratis desde 39 €.</p>

    <div class="bf__cuenta" data-bf-inicio="{{ section.settings.inicio }}" data-bf-fin="{{ section.settings.fin }}" hidden>
      <span class="bf__cuenta-txt" data-bf-txt>Termina en</span>
      <span class="bf__cuenta-num"><b data-bf-d>0</b><small>días</small></span>
      <span class="bf__cuenta-num"><b data-bf-h>00</b><small>h</small></span>
      <span class="bf__cuenta-num"><b data-bf-m>00</b><small>min</small></span>
      <span class="bf__cuenta-num"><b data-bf-s>00</b><small>s</small></span>
    </div>

    <ul class="bf__grid">
      {%- for handle in productos -%}
        {%- assign p = all_products[handle] -%}
        {%- if p != blank -%}
          {%- assign rebajado = p.price | times: factor | divided_by: 100 -%}
          <li class="bf__card">
            <a href="{{ p.url }}" class="bf__card-link">
              <span class="bf__chapa">−{{ pct }} %</span>
              {%- if p.featured_image -%}
                {{ p.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(max-width: 749px) 50vw, 25vw', class: 'bf__img', alt: p.title }}
              {%- endif -%}
              <span class="bf__nombre">{{ p.title }}</span>
              <span class="bf__precios">
                <s>{{ p.price | money }}</s>
                <strong>{{ rebajado | money }}</strong>
              </span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    <a class="bf__btn" href="{{ section.settings.enlace | default: routes.all_products_collection_url }}">Ver todas las ofertas</a>
    <p class="bf__legal">Precio tachado: precio habitual de la tienda en los 30 días anteriores. −{{ pct2 }} % sobre el total de los productos al llevar 2 o más unidades; no acumulable con otros descuentos. Válido del {{ section.settings.fechas }} o hasta fin de existencias.</p>
  </div>
</section>

<script>
  (function () {
    var el = document.querySelector('[data-bf-inicio]');
    if (!el) return;
    var ini = Date.parse(el.dataset.bfInicio), fin = Date.parse(el.dataset.bfFin);
    var q = function (s) { return el.querySelector(s); };
    var dos = function (n) { return (n < 10 ? '0' : '') + n; };
    function tic() {
      var ahora = Date.now(), objetivo;
      if (ahora < ini) { objetivo = ini; q('[data-bf-txt]').textContent = 'Empieza en'; }
      else if (ahora < fin) { objetivo = fin; q('[data-bf-txt]').textContent = 'Termina en'; }
      else { el.hidden = true; return; }
      var t = Math.floor((objetivo - ahora) / 1000);
      q('[data-bf-d]').textContent = Math.floor(t / 86400);
      q('[data-bf-h]').textContent = dos(Math.floor(t % 86400 / 3600));
      q('[data-bf-m]').textContent = dos(Math.floor(t % 3600 / 60));
      q('[data-bf-s]').textContent = dos(t % 60);
      el.hidden = false;
    }
    tic(); setInterval(tic, 1000);
  })();
</script>

<style>
  .bf{--bf-oro:#FFB547;--bf-amarillo:#FFE14D;--bf-negro:#07070C;position:relative;overflow:hidden;background:radial-gradient(120% 80% at 50% 0%,#1d1640 0%,var(--bf-negro) 60%);color:#FFF6E9;text-align:center;padding:56px 0 48px}
  .bf__estrellas{position:absolute;inset:0;background-image:radial-gradient(1.5px 1.5px at 12% 18%,#fff8 50%,transparent 51%),radial-gradient(1px 1px at 78% 12%,#fff9 50%,transparent 51%),radial-gradient(1.5px 1.5px at 64% 70%,#fff6 50%,transparent 51%),radial-gradient(1px 1px at 30% 82%,#fff7 50%,transparent 51%),radial-gradient(1px 1px at 90% 54%,#fff6 50%,transparent 51%);pointer-events:none}
  .bf__inner{position:relative;padding-inline:16px}
  .bf__eyebrow{display:inline-block;margin:0 0 14px;padding:6px 14px;border:1px solid #FFB54766;border-radius:99px;font-size:.8rem;letter-spacing:.14em;text-transform:uppercase;color:var(--bf-oro)}
  .bf__titulo{margin:0 auto 22px;max-width:15ch;font-size:clamp(2rem,7vw,3.6rem);line-height:1.05;color:#fff;text-transform:uppercase}
  .bf__marca{display:inline-block;margin-top:8px;padding:2px 12px;background:var(--bf-amarillo);color:#000;border:3px solid #000;box-shadow:0 0 0 2px var(--bf-amarillo);transform:rotate(-2deg)}
  .bf__ofertas{display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-bottom:12px}
  .bf__oferta{min-width:150px;padding:14px 18px;border:1px solid #ffffff2e;border-radius:16px;background:#ffffff0d;display:flex;flex-direction:column;align-items:center}
  .bf__oferta--top{border-color:var(--bf-oro);background:#FFB5471f;box-shadow:0 0 40px #FFB54740}
  .bf__pct{font-family:var(--orb-display,inherit);font-weight:800;font-size:clamp(2.2rem,8vw,3.2rem);line-height:1;color:var(--bf-oro)}
  .bf__txt{margin-top:6px;font-size:.95rem}
  .bf__nota{margin:0 0 18px;font-size:.9rem;color:#d9d6ee}
  .bf__cuenta{display:inline-flex;align-items:center;gap:8px;margin-bottom:28px;padding:10px 14px;border-radius:14px;background:#000;border:1px solid #ffffff26}
  .bf__cuenta[hidden]{display:none}
  .bf__cuenta-txt{font-size:.8rem;text-transform:uppercase;letter-spacing:.1em;color:var(--bf-oro);margin-right:4px}
  .bf__cuenta-num{display:flex;flex-direction:column;align-items:center;min-width:42px}
  .bf__cuenta-num b{font-size:1.4rem;font-variant-numeric:tabular-nums}
  .bf__cuenta-num small{font-size:.65rem;color:#bbb}
  .bf__grid{list-style:none;margin:0 0 26px;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
  @media (min-width:750px){.bf__grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}}
  .bf__card-link{position:relative;display:flex;flex-direction:column;height:100%;padding:10px;border-radius:16px;background:#ffffff0f;border:1px solid #ffffff1f;color:inherit;text-decoration:none;transition:transform .2s,border-color .2s}
  .bf__card-link:hover{transform:translateY(-3px);border-color:var(--bf-oro)}
  .bf__chapa{position:absolute;top:16px;left:16px;z-index:1;padding:4px 10px;border-radius:99px;background:var(--bf-amarillo);color:#000;font-weight:800;font-size:.85rem}
  .bf__img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:10px;background:#111}
  .bf__nombre{margin-top:10px;font-size:.9rem;line-height:1.3;min-height:2.6em}
  .bf__precios{margin-top:6px;display:flex;gap:8px;justify-content:center;align-items:baseline;flex-wrap:wrap}
  .bf__precios s{color:#9a98b5;font-size:.85rem}
  .bf__precios strong{color:var(--bf-oro);font-size:1.1rem}
  .bf__btn{display:inline-block;padding:15px 30px;border-radius:99px;background:var(--bf-oro);color:#12123A;font-weight:800;text-decoration:none;box-shadow:0 0 30px #FFB54766}
  .bf__legal{margin:18px auto 0;max-width:60ch;font-size:.72rem;line-height:1.5;color:#8f8daa}
</style>

{% schema %}
{
  "name": "Black Friday",
  "settings": [
    { "type": "text", "id": "fechas", "label": "Fechas (texto)", "default": "23 al 30 de noviembre" },
    { "type": "text", "id": "inicio", "label": "Inicio (ISO)", "default": "2026-11-23T00:00:00+01:00" },
    { "type": "text", "id": "fin", "label": "Fin (ISO)", "default": "2026-11-30T23:59:59+01:00" },
    { "type": "number", "id": "descuento_uno", "label": "% en todo", "default": 15 },
    { "type": "number", "id": "descuento_dos", "label": "% llevando 2 o más", "default": 25 },
    { "type": "url", "id": "enlace", "label": "Enlace del botón" }
  ],
  "presets": [{ "name": "Black Friday" }]
}
{% endschema %}
