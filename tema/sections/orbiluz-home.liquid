{%- comment -%}
  Portada de Orbiluz: hero, confianza, productos, efecto, promo, ventajas y preguntas frecuentes.
  Autocontenida (estilos con prefijo .orb-) para no depender de la maquetación de Horizon.
{%- endcomment -%}
{%- liquid
  assign hero_desk = images['banner-portada-escritorio.jpg']
  assign hero_mob = images['banner-portada-movil.jpg']
  assign p_ondas = all_products['proyector-ondas-de-agua']
  assign p_reloj = all_products['reloj-led-3d']
  assign p_bola = all_products['lampara-bola-cristal-3d']
-%}

<div class="orb">
  {%- comment -%} HERO {%- endcomment -%}
  <section class="orb-hero" aria-label="Presentación">
    <picture class="orb-hero__media">
      {%- if hero_mob != blank -%}
        <source media="(max-width: 749px)" srcset="{{ hero_mob | image_url: width: 900 }} 900w, {{ hero_mob | image_url: width: 1200 }} 1200w" sizes="100vw">
      {%- endif -%}
      {%- if hero_desk != blank -%}
        <img src="{{ hero_desk | image_url: width: 1600 }}" srcset="{{ hero_desk | image_url: width: 1200 }} 1200w, {{ hero_desk | image_url: width: 1800 }} 1800w, {{ hero_desk | image_url: width: 2400 }} 2400w" sizes="100vw" alt="{{ hero_desk.alt | escape }}" width="2400" height="1200" fetchpriority="high">
      {%- endif -%}
    </picture>
    <div class="orb-hero__shade"></div>
    <div class="orb-hero__content page-width">
      <p class="orb-eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="orb-hero__title">{{ section.settings.heading }}</h1>
      <p class="orb-hero__text">{{ section.settings.subheading }}</p>
      <div class="orb-hero__ctas">
        <a class="orb-btn orb-btn--amber" href="#orb-productos">Ver productos</a>
        <a class="orb-btn orb-btn--ghost" href="#orb-promo">−10 % con HOLA10</a>
      </div>
    </div>
  </section>

  {%- comment -%} BARRA DE CONFIANZA {%- endcomment -%}
  <section class="orb-trust" aria-label="Ventajas de comprar en Orbiluz">
    <ul class="orb-trust__list page-width">
      <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v8H3zM14 10h4l3 3v2h-7z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="7" cy="17" r="1.8" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="17" cy="17" r="1.8" fill="none" stroke="currentColor" stroke-width="1.6"/></svg><span><strong>Envío gratis</strong> desde 39 €</span></li>
      <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="10" r="2.4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg><span><strong>Seguimiento</strong> en todos los pedidos</span></li>
      <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.3-5.6M4 4v4h4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><span><strong>14 días</strong> para devolver</span></li>
      <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="10" width="16" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M8 10V7a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="1.6"/></svg><span><strong>Pago seguro</strong> y cifrado</span></li>
    </ul>
  </section>

  {%- comment -%} PRODUCTOS {%- endcomment -%}
  <section id="orb-productos" class="orb-products page-width" aria-labelledby="orb-productos-title">
    <p class="orb-eyebrow orb-eyebrow--dark">Nuestra colección</p>
    <h2 id="orb-productos-title" class="orb-h2">Tres piezas que dan que hablar</h2>
    <div class="orb-grid">
      {%- for p in (1..3) -%}
        {%- case p -%}
          {%- when 1 -%}{%- assign prod = p_ondas -%}{%- assign tag = 'Viral' -%}{%- assign linea = 'Olas de luz en techo y paredes. 16 colores y mando.' -%}
          {%- when 2 -%}{%- assign prod = p_bola -%}{%- assign tag = '2 por 39,90 €' -%}{%- assign linea = 'Saturno, Luna, Galaxia o Sistema solar grabados en cristal.' -%}
          {%- when 3 -%}{%- assign prod = p_reloj -%}{%- assign tag = 'De pared o de mesa' -%}{%- assign linea = 'Dígitos LED 3D con hora, fecha, temperatura y alarmas.' -%}
        {%- endcase -%}
        {%- if prod != blank and prod.id -%}
          <article class="orb-card">
            <a class="orb-card__link" href="{{ prod.url }}" aria-label="{{ prod.title | escape }}">
              <div class="orb-card__media">
                {%- if prod.featured_media -%}
                  {{ prod.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw', class: 'orb-card__img', alt: prod.featured_media.alt }}
                {%- endif -%}
                {%- if prod.media[1] -%}
                  {{ prod.media[1] | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw', class: 'orb-card__img orb-card__img--alt', alt: '' }}
                {%- endif -%}
                <span class="orb-tag">{{ tag }}</span>
              </div>
              <div class="orb-card__body">
                <h3 class="orb-card__title">{{ prod.title }}</h3>
                <p class="orb-card__line">{{ linea }}</p>
                <div class="orb-card__foot">
                  <span class="orb-card__price">{%- if prod.price_varies -%}Desde {% endif -%}{{ prod.price | money }}</span>
                  <span class="orb-btn orb-btn--small">Ver</span>
                </div>
              </div>
            </a>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  {%- comment -%} DESTACADO: PROYECTOR {%- endcomment -%}
  {%- if p_ondas != blank and p_ondas.id -%}
    <section class="orb-feature" aria-labelledby="orb-feature-title">
      <div class="orb-feature__inner page-width">
        <div class="orb-feature__media">
          {%- assign efecto = p_ondas.media[1] | default: p_ondas.featured_media -%}
          {{ efecto | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 900, 1200', sizes: '(min-width: 990px) 50vw, 100vw', alt: efecto.alt }}
        </div>
        <div class="orb-feature__text">
          <p class="orb-eyebrow">El favorito de las redes</p>
          <h2 id="orb-feature-title" class="orb-h2 orb-h2--light">Apaga la luz. Enciende el mar.</h2>
          <p>El proyector de ondas de agua llena el techo y las paredes de reflejos en movimiento. Elige entre 16 colores con el mando, regula el brillo y deja que la habitación haga el resto.</p>
          <ul class="orb-checks">
            <li>Efecto de agua en movimiento</li>
            <li>Mando a distancia y botón táctil</li>
            <li>Funciona con cualquier cargador USB</li>
          </ul>
          <a class="orb-btn orb-btn--amber" href="{{ p_ondas.url }}">Descubrir el proyector · {{ p_ondas.price | money }}</a>
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} PROMO {%- endcomment -%}
  <section id="orb-promo" class="orb-promo page-width" aria-label="Ofertas">
    <div class="orb-promo__card orb-promo__card--amber">
      <p class="orb-eyebrow orb-eyebrow--dark">Primera compra</p>
      <p class="orb-promo__big">−10 %</p>
      <p>con el código <button type="button" class="orb-code" data-orb-copy="HOLA10" aria-label="Copiar el código HOLA10">HOLA10</button></p>
      <p class="orb-small">Se aplica al pagar. Un uso por cliente.</p>
    </div>
    <div class="orb-promo__card orb-promo__card--night">
      <p class="orb-eyebrow">Para regalar (o regalarte)</p>
      <p class="orb-promo__big">2 × 39,90 €</p>
      <p>Llévate dos lámparas bola de cristal y combina modelos.</p>
      {%- if p_bola != blank and p_bola.id -%}<a class="orb-btn orb-btn--amber orb-btn--small" href="{{ p_bola.url }}">Elegir mis dos</a>{%- endif -%}
    </div>
  </section>

  {%- comment -%} VENTAJAS {%- endcomment -%}
  <section class="orb-why page-width" aria-labelledby="orb-why-title">
    <h2 id="orb-why-title" class="orb-h2">Por qué Orbiluz</h2>
    <div class="orb-why__grid">
      <div class="orb-why__item">
        <span class="orb-why__icon" aria-hidden="true">✦</span>
        <h3>Pocos productos, bien elegidos</h3>
        <p>Solo vendemos piezas llamativas con miles de pedidos y buenas valoraciones de sus fabricantes.</p>
      </div>
      <div class="orb-why__item">
        <span class="orb-why__icon" aria-hidden="true">☾</span>
        <h3>Sin sorpresas</h3>
        <p>Medidas reales, qué incluye cada producto y qué no, y plazos de envío claros antes de comprar.</p>
      </div>
      <div class="orb-why__item">
        <span class="orb-why__icon" aria-hidden="true">✉</span>
        <h3>Te atendemos en español</h3>
        <p>Escríbenos a <a href="mailto:orbiluzsupport@gmail.com">orbiluzsupport@gmail.com</a> y te respondemos en 24-48 horas laborables.</p>
      </div>
    </div>
  </section>

  {%- comment -%} PREGUNTAS FRECUENTES {%- endcomment -%}
  <section class="orb-faq page-width" aria-labelledby="orb-faq-title">
    <h2 id="orb-faq-title" class="orb-h2">Preguntas frecuentes</h2>
    <details><summary>¿Cuánto tarda en llegar mi pedido?</summary><p>Preparamos el pedido en 1-3 días laborables y el envío con seguimiento tarda normalmente entre 6 y 17 días laborables, según el producto. Te enviamos el número de seguimiento por correo.</p></details>
    <details><summary>¿Cuánto cuesta el envío?</summary><p>Es gratis a partir de 39 €. Por debajo de esa cantidad cuesta 3,95 € a toda la península y Baleares.</p></details>
    <details><summary>¿Puedo devolver un producto?</summary><p>Sí. Tienes 14 días naturales desde que lo recibes para desistir de la compra. Consulta los pasos en nuestra <a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">política de devoluciones</a>.</p></details>
    <details><summary>¿Incluyen cargador?</summary><p>Todos funcionan por USB e incluyen su cable, pero no el cargador de pared. Sirve cualquier cargador de móvil con salida USB.</p></details>
    <details><summary>¿Cómo uso el código HOLA10?</summary><p>Escríbelo en la casilla de código de descuento al pagar. Te descuenta un 10 % en tu primer pedido.</p></details>
    <details><summary>¿Qué métodos de pago aceptáis?</summary><p>Tarjeta de crédito o débito y los métodos que aparecen en la página de pago. El pago está cifrado y no guardamos los datos de tu tarjeta.</p></details>
  </section>
</div>

<script>
  document.querySelectorAll('[data-orb-copy]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var code = btn.getAttribute('data-orb-copy');
      var done = function () { var t = btn.textContent; btn.textContent = '¡Copiado!'; setTimeout(function () { btn.textContent = t; }, 1600); };
      if (navigator.clipboard) { navigator.clipboard.writeText(code).then(done, done); } else { done(); }
    });
  });
</script>

{% stylesheet %}
  .orb{--noche:#12123A;--ambar:#FFB547;--nebulosa:#7C6CF6;--luna:#FFF6E9;--niebla:#A7A9C9;color:var(--noche)}
  .orb *{box-sizing:border-box}
  .orb .page-width{max-width:1200px;margin-inline:auto;padding-inline:16px}
  .orb-eyebrow{font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;font-weight:600;color:var(--ambar);margin:0 0 .6rem}
  .orb-eyebrow--dark{color:var(--nebulosa)}
  .orb-h2{font-family:"Unbounded",var(--font-heading--family),sans-serif;font-size:clamp(1.5rem,4vw,2.3rem);line-height:1.15;margin:0 0 1.6rem;color:var(--noche)}
  .orb-h2--light{color:var(--luna)}
  .orb-btn{display:inline-flex;align-items:center;justify-content:center;gap:.4rem;min-height:48px;padding:.8rem 1.5rem;border-radius:999px;font-weight:700;text-decoration:none;border:2px solid transparent;transition:transform .15s ease,box-shadow .15s ease;cursor:pointer;font-size:1rem}
  .orb-btn:hover{transform:translateY(-2px)}
  .orb-btn--amber{background:var(--ambar);color:var(--noche);box-shadow:0 8px 24px rgba(255,181,71,.35)}
  .orb-btn--ghost{border-color:rgba(255,246,233,.7);color:var(--luna)}
  .orb-btn--small{min-height:40px;padding:.5rem 1.1rem;font-size:.9rem;background:var(--noche);color:var(--luna)}
  .orb-btn--amber.orb-btn--small{background:var(--ambar);color:var(--noche)}
  /* Hero */
  .orb-hero{position:relative;min-height:min(88vh,760px);display:flex;align-items:flex-end;background:var(--noche);overflow:hidden}
  .orb-hero__media,.orb-hero__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .orb-hero__shade{position:absolute;inset:0;background:linear-gradient(0deg,rgba(18,18,58,.92) 0%,rgba(18,18,58,.35) 45%,rgba(18,18,58,0) 70%)}
  .orb-hero__content{position:relative;z-index:1;padding-block:2.5rem 2.8rem;width:100%}
  .orb-hero__title{font-family:"Unbounded",var(--font-heading--family),sans-serif;color:var(--luna);font-size:clamp(2rem,8vw,4.2rem);line-height:1.05;margin:0 0 1rem;max-width:14ch}
  .orb-hero__text{color:#e9e6ff;font-size:clamp(1rem,2.6vw,1.2rem);max-width:36ch;margin:0 0 1.6rem}
  .orb-hero__ctas{display:flex;flex-wrap:wrap;gap:.8rem}
  @media (min-width:750px){
    .orb-hero{align-items:center}
    .orb-hero__shade{background:linear-gradient(90deg,rgba(18,18,58,.95) 0%,rgba(18,18,58,.6) 38%,rgba(18,18,58,0) 62%)}
    .orb-hero__content{padding-block:4rem}
  }
  /* Confianza */
  .orb-trust{background:var(--noche);color:var(--luna);border-top:1px solid rgba(167,169,201,.2)}
  .orb-trust__list{list-style:none;margin:0;padding-block:1rem;display:grid;grid-template-columns:repeat(2,1fr);gap:.9rem 1rem}
  .orb-trust li{display:flex;align-items:center;gap:.6rem;font-size:.9rem;line-height:1.25}
  .orb-trust svg{width:26px;height:26px;flex:none;color:var(--ambar)}
  @media (min-width:990px){.orb-trust__list{grid-template-columns:repeat(4,1fr)}}
  /* Productos */
  .orb-products{padding-block:3.5rem 2.5rem}
  .orb-grid{display:grid;gap:1.2rem;grid-template-columns:1fr}
  @media (min-width:750px){.orb-grid{grid-template-columns:repeat(2,1fr)}}
  @media (min-width:990px){.orb-grid{grid-template-columns:repeat(3,1fr)}}
  .orb-card{background:#fff;border-radius:22px;overflow:hidden;box-shadow:0 10px 30px rgba(18,18,58,.08);transition:transform .2s ease,box-shadow .2s ease}
  .orb-card:hover{transform:translateY(-4px);box-shadow:0 18px 40px rgba(18,18,58,.14)}
  .orb-card__link{display:block;color:inherit;text-decoration:none}
  .orb-card__media{position:relative;aspect-ratio:1/1;background:var(--noche)}
  .orb-card__img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:opacity .35s ease}
  .orb-card__img--alt{opacity:0}
  @media (hover:hover){.orb-card:hover .orb-card__img--alt{opacity:1}}
  .orb-tag{position:absolute;top:14px;left:14px;background:var(--ambar);color:var(--noche);font-weight:700;font-size:.78rem;padding:.35rem .75rem;border-radius:999px}
  .orb-card__body{padding:1.1rem 1.2rem 1.3rem}
  .orb-card__title{font-family:"Unbounded",var(--font-heading--family),sans-serif;font-size:1.05rem;margin:0 0 .4rem;line-height:1.25}
  .orb-card__line{margin:0 0 1rem;color:#4a4a6a;font-size:.95rem;min-height:2.6em}
  .orb-card__foot{display:flex;align-items:center;justify-content:space-between;gap:1rem}
  .orb-card__price{font-weight:800;font-size:1.2rem}
  /* Destacado */
  .orb-feature{background:radial-gradient(120% 120% at 80% 0%,#2a2470 0%,var(--noche) 55%);color:#e9e6ff;padding-block:3.5rem}
  .orb-feature__inner{display:grid;gap:2rem;align-items:center}
  .orb-feature__media img{width:100%;height:auto;border-radius:22px;display:block}
  .orb-feature__text p{font-size:1.05rem;line-height:1.6}
  .orb-checks{list-style:none;padding:0;margin:1.2rem 0 1.8rem;display:grid;gap:.6rem}
  .orb-checks li{padding-left:1.8rem;position:relative}
  .orb-checks li:before{content:"✓";position:absolute;left:0;top:0;color:var(--noche);background:var(--ambar);width:1.25rem;height:1.25rem;border-radius:50%;font-size:.8rem;font-weight:800;display:grid;place-items:center}
  @media (min-width:990px){.orb-feature__inner{grid-template-columns:1.1fr 1fr;gap:3.5rem}}
  /* Promo */
  .orb-promo{display:grid;gap:1.2rem;padding-block:3rem}
  @media (min-width:750px){.orb-promo{grid-template-columns:1fr 1fr}}
  .orb-promo__card{border-radius:22px;padding:2rem 1.6rem}
  .orb-promo__card p{margin:.3rem 0}
  .orb-promo__card--amber{background:var(--ambar);color:var(--noche)}
  .orb-promo__card--night{background:var(--noche);color:var(--luna)}
  .orb-promo__big{font-family:"Unbounded",var(--font-heading--family),sans-serif;font-size:clamp(2.2rem,7vw,3.2rem);font-weight:800;line-height:1.05;margin:.2rem 0 .6rem!important}
  .orb-code{font:inherit;font-weight:800;letter-spacing:.08em;background:var(--noche);color:var(--ambar);border:0;border-radius:10px;padding:.35rem .8rem;cursor:pointer}
  .orb-small{font-size:.85rem;opacity:.8}
  .orb-promo__card .orb-btn{margin-top:1rem}
  /* Ventajas */
  .orb-why{padding-block:2.5rem}
  .orb-why__grid{display:grid;gap:1.2rem}
  @media (min-width:750px){.orb-why__grid{grid-template-columns:repeat(3,1fr)}}
  .orb-why__item{background:#fff;border-radius:22px;padding:1.6rem;box-shadow:0 6px 20px rgba(18,18,58,.06)}
  .orb-why__item h3{font-family:"Unbounded",var(--font-heading--family),sans-serif;font-size:1rem;margin:.6rem 0 .4rem}
  .orb-why__item p{margin:0;color:#4a4a6a;line-height:1.55}
  .orb-why__icon{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:var(--noche);color:var(--ambar);font-size:1.2rem}
  /* FAQ */
  .orb-faq{padding-block:2.5rem 4rem;max-width:820px}
  .orb-faq details{background:#fff;border-radius:16px;margin-bottom:.8rem;box-shadow:0 4px 14px rgba(18,18,58,.05)}
  .orb-faq summary{cursor:pointer;list-style:none;padding:1.1rem 3rem 1.1rem 1.2rem;font-weight:700;position:relative;min-height:48px}
  .orb-faq summary::-webkit-details-marker{display:none}
  .orb-faq summary:after{content:"+";position:absolute;right:1.2rem;top:50%;transform:translateY(-50%);font-size:1.4rem;color:var(--nebulosa)}
  .orb-faq details[open] summary:after{content:"−"}
  .orb-faq details p{margin:0;padding:0 1.2rem 1.2rem;line-height:1.6;color:#3a3a5a}
{% endstylesheet %}

{% schema %}
{
  "name": "Portada Orbiluz",
  "tag": "div",
  "class": "orb-home-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Decoración que se enciende" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Tu casa, de otro planeta" },
    { "type": "textarea", "id": "subheading", "label": "Texto", "default": "Lámparas y relojes originales que convierten cualquier rincón en el favorito de la casa. Envío gratis desde 39 €." }
  ],
  "presets": [{ "name": "Portada Orbiluz" }]
}
{% endschema %}
